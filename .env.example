# ───────────────────────────────────────────────
# Plantilla de variables de entorno
# ───────────────────────────────────────────────
# Copiar a `.env` y rellenar con secretos FUERTES. El `.env` real NO se versiona.
# Generación rápida:  ./scripts/gen-secrets.sh
# Generar un secreto:  openssl rand -base64 24
#
# En producción, docker-compose ABORTA el arranque si falta alguna de las
# contraseñas (sin defaults inseguros). Ver docker-compose.yml.

# PostgreSQL
DB_USER=prestamos
DB_PASSWORD=

# Keycloak admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# RabbitMQ
RABBITMQ_USER=prestamos
RABBITMQ_PASSWORD=

# Grafana admin
GRAFANA_USER=admin
GRAFANA_PASSWORD=
